# Never commit a real key. The UI can also set these values for the current session.
RADAR_AI_BASE_URL=https://api.openai.com/v1
RADAR_AI_API_KEY=
RADAR_AI_MODEL=gpt-4.1-mini
# responses, chat, or auto. Use chat for providers exposing /v1/chat/completions.
RADAR_AI_MODE=auto
RADAR_AI_TIMEOUT_SECONDS=90
RADAR_DB_PATH=data/radar.db

# Optional Tavily provider. SearXNG needs only its URL in the Web search UI.
TAVILY_API_KEY=
